# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
/plan
.slim/deepwork/

# Native CrispASR/CrispEmbed binaries are fetched by scripts/ci, never committed.
# native/ is ignored except its README, which documents versions/licenses, and
# the first-party decode source tree (third_party/ is cloned by scripts/ci).
native/*
!native/README.md
!native/FFMPEG-NOTICE.txt
!native/decode/
!native/sherpa_mnn/
!native/sherpa_mnn/**
native/decode/third_party/
*.so

# ccache for the native Android build (CI caches it via actions/cache).
/.ccache/
/.ccache-sherpa-mnn/
# Stable build work dir for scripts/ci/build_native_android.sh (keeps ccache hits).
/.native-work/
/.native-work-sherpa-mnn/
# Stable source/build directory for the pinned Windows CrispEmbed build.
/.native-work-windows/
android/key.properties

# Android/Gradle first-sync artifacts
/android/build/
/android/.project
/android/.settings/

# CodeGraph local index (not tracked)
/.codegraph/
